#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_PATH=/data/options.json

read_option() {
  local key="$1"
  local fallback="${2:-}"
  jq -r --arg key "$key" --arg fallback "$fallback" '.[$key] // $fallback' "$CONFIG_PATH"
}

read_bool() {
  local key="$1"
  jq -r --arg key "$key" '.[$key] // false' "$CONFIG_PATH"
}

OPENAI_API_KEY="$(read_option openai_api_key)"
HOME_ASSISTANT_TOKEN="$(read_option home_assistant_token)"
HA_LONG_LIVED_TOKEN="$(read_option ha_long_lived_token)"
MCP_SERVER_URL="$(read_option mcp_server_url)"
MCP_SERVER_API_KEY="$(read_option mcp_server_api_key)"
CODEX_MODEL="$(read_option codex_model gpt-5.3-codex)"
CODEX_HOME="$(read_option codex_home /data/codex)"
WORKSPACE="$(read_option workspace /ha_config)"
REQUIRE_CONFIRMATION="$(read_bool require_confirmation)"
INSTALL_MCP_SERVERS="$(read_bool install_mcp_servers)"
SSH_ENABLED="$(read_bool ssh_enabled)"
WEB_TERMINAL_ENABLED="$(read_bool web_terminal_enabled)"

if [[ -n "$OPENAI_API_KEY" ]]; then
  export OPENAI_API_KEY
else
  unset OPENAI_API_KEY
fi
export HOME_ASSISTANT_TOKEN
export HA_LONG_LIVED_TOKEN
export MCP_SERVER_URL
export MCP_SERVER_API_KEY
export CODEX_MODEL
export CODEX_HOME
export WORKSPACE
export WEB_TERMINAL_ENABLED
export HOME="$CODEX_HOME"
export HA_URL="http://supervisor/core/api"
export SUPERVISOR_URL="http://supervisor"

mkdir -p "$CODEX_HOME" "$WORKSPACE" /data/logs /data/mcp /run/sshd
chmod 700 "$CODEX_HOME"

if [[ -n "$HOME_ASSISTANT_TOKEN" ]]; then
  export HA_TOKEN="$HOME_ASSISTANT_TOKEN"
elif [[ -n "$HA_LONG_LIVED_TOKEN" ]]; then
  export HA_TOKEN="$HA_LONG_LIVED_TOKEN"
else
  export HA_TOKEN="${SUPERVISOR_TOKEN:-}"
fi

cat > "$CODEX_HOME/config.toml" <<'EOF'
cli_auth_credentials_store = "file"
EOF

cat > "$CODEX_HOME/AGENTS.md" <<'EOF'
# Codex Agent Home Assistant Context

You are running inside the Home Assistant Codex Agent add-on.

Use these commands for live Home Assistant context:

- `ha-states`: list all entities, including sensors, binary sensors, switches, lights, automations, scripts, and integrations.
- `ha-services`: list every service exposed by Home Assistant.
- `ha-api METHOD /path '{"json":"body"}'`: call the Home Assistant REST API through the Supervisor proxy.
- `ha-call-service domain service '{"entity_id":"sensor.example"}'`: call a Home Assistant service.
- `supervisor-api METHOD /path '{"json":"body"}'`: call Supervisor API for add-ons, logs, services, and system management.

Prefer reading live state through `ha-states` and `ha-services` before editing YAML or restarting services.
EOF

ensure_mcp_server() {
  local name="$1"
  shift
  if codex mcp get "$name" >/dev/null 2>&1; then
    return 0
  fi
  codex mcp add "$name" "$@"
}

if [[ "$INSTALL_MCP_SERVERS" == "true" ]]; then
  ensure_mcp_server ha-config -- npx -y @modelcontextprotocol/server-filesystem /ha_config /addon_config /all_addon_configs /addons /share
  ensure_mcp_server memory -- npx -y @modelcontextprotocol/server-memory
  if [[ -n "$MCP_SERVER_URL" ]]; then
    if [[ -n "$MCP_SERVER_API_KEY" ]]; then
      export MCP_SERVER_API_KEY
      ensure_mcp_server remote-home-assistant --url "$MCP_SERVER_URL" --bearer-token-env-var MCP_SERVER_API_KEY
    else
      ensure_mcp_server remote-home-assistant --url "$MCP_SERVER_URL"
    fi
  fi
fi

if [[ "$SSH_ENABLED" == "true" ]]; then
  mkdir -p "$CODEX_HOME/.ssh"
  jq -r '.ssh_public_keys[]? // empty' "$CONFIG_PATH" > "$CODEX_HOME/.ssh/authorized_keys"
  chmod 700 "$CODEX_HOME/.ssh"
  chmod 600 "$CODEX_HOME/.ssh/authorized_keys"
  /usr/sbin/sshd -D -p 2222 &
fi

if [[ "$WEB_TERMINAL_ENABLED" == "true" ]]; then
  ttyd \
    --port 8099 \
    --interface 0.0.0.0 \
    --reconnect 30 \
    --ping-interval 2 \
    --writable \
    --terminal-type xterm-256color \
    --client-option titleFixed="Codex Agent" \
    --client-option disableLeaveAlert=true \
    /bin/bash /usr/local/bin/codex-agent-shell &
fi

cat >/data/README-runtime.txt <<EOF
Codex Agent runtime

Workspace: ${WORKSPACE}
Codex home: ${CODEX_HOME}
Home Assistant API: ${HA_URL}
Supervisor API: ${SUPERVISOR_URL}
Home Assistant token configured: $(if [[ -n "${HA_TOKEN:-}" ]]; then echo "yes"; else echo "no"; fi)
MCP remote configured: $(if [[ -n "${MCP_SERVER_URL:-}" ]]; then echo "yes"; else echo "no"; fi)
MCP servers: $(codex mcp list 2>/dev/null | tr '\n' '; ' || true)

Useful commands:
  Open the Codex Agent sidebar panel for a web terminal.
  codex-login-chatgpt
  codex --model "${CODEX_MODEL}" "${WORKSPACE}"
  ha-states
  ha-services
  ha-api GET /config
  ha-call-service light turn_on '{"entity_id":"light.example"}'
  supervisor-api GET /addons
  host-shell
EOF

echo "[codex-agent] ready"
echo "[codex-agent] workspace: ${WORKSPACE}"
echo "[codex-agent] require_confirmation: ${REQUIRE_CONFIRMATION}"
echo "[codex-agent] web terminal: ${WEB_TERMINAL_ENABLED} on ingress port 8099"
echo "[codex-agent] start a shell with: docker exec -it <container> bash"

tail -f /dev/null
