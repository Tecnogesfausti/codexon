#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_PATH=/data/options.json

read_option() {
  local key="$1"
  local fallback="${2:-}"
  jq -r --arg key "$key" --arg fallback "$fallback" '.[$key] // $fallback' "$CONFIG_PATH"
}

read_bool() {
  local key="$1"
  jq -r --arg key "$key" '.[$key] // false' "$CONFIG_PATH"
}

OPENAI_API_KEY="$(read_option openai_api_key)"
OPENROUTER_API_KEY="$(read_option openrouter_api_key)"
HOME_ASSISTANT_TOKEN="$(read_option home_assistant_token)"
HA_LONG_LIVED_TOKEN="$(read_option ha_long_lived_token)"
MCP_SERVER_URL="$(read_option mcp_server_url)"
MCP_SERVER_API_KEY="$(read_option mcp_server_api_key)"
CODEX_MODEL="$(read_option codex_model gpt-5.3-codex)"
CODEX_HOME="$(read_option codex_home /data/codex)"
WORKSPACE="$(read_option workspace /ha_config)"
REQUIRE_CONFIRMATION="$(read_bool require_confirmation)"
INSTALL_MCP_SERVERS="$(read_bool install_mcp_servers)"
SSH_ENABLED="$(read_bool ssh_enabled)"
WEB_TERMINAL_ENABLED="$(read_bool web_terminal_enabled)"
INGRESS_TARGET="$(read_option ingress_target codex)"
SEGURAI_ENABLED="$(read_bool segurai_enabled)"
SEGURAI_WEB_ENABLED="$(read_bool segurai_web_enabled)"
SEGURAI_POLL_SECONDS="$(read_option segurai_poll_seconds 300)"
SEGURAI_SENSOR_PROMPT="$(read_option segurai_sensor_prompt "Consulta sensores de presencia, puertas, ventanas, movimiento, alarma y cámaras si existen.")"
SEGURAI_FS_ROOTS="$(read_option segurai_fs_roots /ha_config,/addon_config,/share)"
SEGURAI_NO_SENSOR_LOOP="$(read_bool segurai_no_sensor_loop)"
SEGURAI_ALLOW_ACTIONS_WITHOUT_CONFIRMATION="$(read_bool segurai_allow_actions_without_confirmation)"
SEGURAI_WHATSAPP_ENABLED="$(read_bool segurai_whatsapp_enabled)"
SEGURAI_WHATSAPP_ALLOWED_SENDERS="$(jq -c '.segurai_whatsapp_allowed_senders // []' "$CONFIG_PATH")"
SEGURAI_WHATSAPP_COMMAND_PREFIX="$(read_option segurai_whatsapp_command_prefix)"
SEGURAI_WHATSAPP_ACCEPT_OWN_MESSAGES="$(read_bool segurai_whatsapp_accept_own_messages)"
SEGURAI_WHATSAPP_ALLOW_GROUPS="$(read_bool segurai_whatsapp_allow_groups)"

if [[ "$INGRESS_TARGET" != "segurai" ]]; then
  INGRESS_TARGET="codex"
fi
if [[ "$INGRESS_TARGET" == "segurai" ]]; then
  CODEX_TERMINAL_PORT=8098
  SEGURAI_WEB_PORT=8099
else
  CODEX_TERMINAL_PORT=8099
  SEGURAI_WEB_PORT=8098
fi

if [[ -n "$OPENAI_API_KEY" ]]; then
  export OPENAI_API_KEY
else
  unset OPENAI_API_KEY
fi
export OPENROUTER_API_KEY
export HOME_ASSISTANT_TOKEN
export HA_LONG_LIVED_TOKEN
export MCP_SERVER_URL
export MCP_SERVER_API_KEY
export CODEX_MODEL
export CODEX_HOME
export PLATFORMIO_CORE_DIR="${PLATFORMIO_CORE_DIR:-$CODEX_HOME/platformio}"
export PLATFORMIO_PACKAGES_DIR="${PLATFORMIO_PACKAGES_DIR:-$PLATFORMIO_CORE_DIR/packages}"
export WORKSPACE
export WEB_TERMINAL_ENABLED
export HOME="$CODEX_HOME"
if [[ -n "${SUPERVISOR_TOKEN:-}" ]]; then
  export HA_URL="http://supervisor/core/api"
else
  export HA_URL="http://homeassistant:8123/api"
fi
export SUPERVISOR_URL="http://supervisor"

mkdir -p "$CODEX_HOME" "$WORKSPACE" "$PLATFORMIO_CORE_DIR" "$PLATFORMIO_PACKAGES_DIR" /data/logs /data/mcp /data/segurai /run/sshd
chmod 700 "$CODEX_HOME"
if [[ ! -f /data/segurai/app/segurai.py ]]; then
  mkdir -p /data/segurai/app
  rsync -a /opt/segurai/app/ /data/segurai/app/
fi

if [[ -n "$HOME_ASSISTANT_TOKEN" ]]; then
  export HA_TOKEN="$HOME_ASSISTANT_TOKEN"
elif [[ -n "$HA_LONG_LIVED_TOKEN" ]]; then
  export HA_TOKEN="$HA_LONG_LIVED_TOKEN"
else
  export HA_TOKEN="${SUPERVISOR_TOKEN:-}"
fi

MCP_AUTH_TOKEN="${MCP_SERVER_API_KEY:-${SUPERVISOR_TOKEN:-${HA_TOKEN:-}}}"
export MCP_AUTH_TOKEN

if [[ -z "${SUPERVISOR_TOKEN:-}" ]]; then
  if [[ -z "$MCP_SERVER_URL" || "$MCP_SERVER_URL" == "http://supervisor/core/api/mcp" ]]; then
    MCP_SERVER_URL="http://homeassistant:8123/api/mcp"
  fi
  export MCP_SERVER_URL
fi

cat > "$CODEX_HOME/config.toml" <<'EOF'
cli_auth_credentials_store = "file"
EOF

cat > "$CODEX_HOME/AGENTS.md" <<'EOF'
# Codex Agent Home Assistant Context

You are running inside the Home Assistant Codex Agent add-on.

Use these commands for live Home Assistant context:

- `ha-states`: list all entities, including sensors, binary sensors, switches, lights, automations, scripts, and integrations.
- `ha-services`: list every service exposed by Home Assistant.
- `ha-api METHOD /path '{"json":"body"}'`: call the Home Assistant REST API through the Supervisor proxy.
- `ha-call-service domain service '{"entity_id":"sensor.example"}'`: call a Home Assistant service.
- `supervisor-api METHOD /path '{"json":"body"}'`: call Supervisor API for add-ons, logs, services, and system management.

Prefer reading live state through `ha-states` and `ha-services` before editing YAML or restarting services.
EOF

ensure_mcp_server() {
  local name="$1"
  shift
  if codex mcp get "$name" >/dev/null 2>&1; then
    return 0
  fi
  codex mcp add "$name" "$@"
}

if [[ "$INSTALL_MCP_SERVERS" == "true" ]]; then
  ensure_mcp_server ha-config -- npx -y @modelcontextprotocol/server-filesystem /ha_config /addon_config /all_addon_configs /addons /share
  ensure_mcp_server memory -- npx -y @modelcontextprotocol/server-memory
  if [[ -n "$MCP_SERVER_URL" ]]; then
    if [[ -n "$MCP_AUTH_TOKEN" ]]; then
      ensure_mcp_server remote-home-assistant --url "$MCP_SERVER_URL" --bearer-token-env-var MCP_AUTH_TOKEN
    else
      ensure_mcp_server remote-home-assistant --url "$MCP_SERVER_URL"
    fi
  fi
fi


start_segurai() {
  local args=(--service)
  if [[ "$SEGURAI_NO_SENSOR_LOOP" == "true" ]]; then
    args+=(--no-sensor-loop)
  fi
  if [[ "$SEGURAI_ALLOW_ACTIONS_WITHOUT_CONFIRMATION" == "true" ]]; then
    args+=(--allow-actions-without-confirmation)
  fi

  export HA_MCP_URL="${MCP_SERVER_URL:-http://supervisor/core/api/mcp}"
  export MCP_AUTH_TOKEN
  export MCP_SERVER_API_KEY
  export HA_TOKEN
  export HOME_ASSISTANT_TOKEN="$HA_TOKEN"
  export HA_LONG_LIVED_TOKEN
  export SEGURAI_DB=/data/segurai/segurai_memory.sqlite3
  export SEGURAI_MODEL_ROUTES=/data/segurai/app/model_routes.yaml
  export SEGURAI_AGENTS_DIR=/data/segurai/app/agents
  export SEGURAI_AGENT_CONFIG=/data/segurai/agent_config.json
  export SEGURAI_CODEX_CONTEXT=/data/segurai/CODEX_CONTEXT.md
  export SEGURAI_CODEX_NOTES=/data/segurai/CODEX_NOTES.md
  export SEGURAI_BACKUP_DIR=/data/segurai/backups
  export SEGURAI_LOG_FILE=/data/segurai/segurai-runtime.log
  export SEGURAI_WORKSPACE="$WORKSPACE"
  export SEGURAI_POLL_SECONDS="$SEGURAI_POLL_SECONDS"
  export SEGURAI_SENSOR_PROMPT="$SEGURAI_SENSOR_PROMPT"
  export SEGURAI_FS_ROOTS="$SEGURAI_FS_ROOTS"
  export SEGURAI_WHATSAPP_ENABLED
  export SEGURAI_WHATSAPP_ALLOWED_SENDERS
  export SEGURAI_WHATSAPP_COMMAND_PREFIX
  export SEGURAI_WHATSAPP_ACCEPT_OWN_MESSAGES
  export SEGURAI_WHATSAPP_ALLOW_GROUPS
  export SEGURAI_WHATSAPP_REJECT_CALLS=true
  export SEGURAI_WHATSAPP_DATA_DIR=/data/segurai/whatsapp
  export SEGURAI_WHATSAPP_BRIDGE=/opt/codex-agent/whatsapp-core/bridge.mjs

  if [[ -n "${OPENROUTER_API_KEY:-}" && "$SEGURAI_ENABLED" == "true" ]]; then
    echo "[$(date -Is)] SegurAI service starting with MCP ${HA_MCP_URL}" >>/data/segurai/segurai-service.log
    (cd /data/segurai/app && /opt/segurai/bin/python segurai.py "${args[@]}") >>/data/segurai/segurai-service.log 2>&1 &
  elif [[ "$SEGURAI_ENABLED" == "true" ]]; then
    echo "[$(date -Is)] SegurAI service disabled: openrouter_api_key is empty" >>/data/segurai/segurai-service.log
  fi

  if [[ "$SEGURAI_WEB_ENABLED" == "true" || "$INGRESS_TARGET" == "segurai" ]]; then
    echo "[$(date -Is)] SegurAI web starting on ${SEGURAI_WEB_PORT}" >>/data/segurai/segurai-web.log
    (cd /data/segurai/app && SEGURAI_DATA_DIR=/data/segurai /opt/segurai/bin/python -m uvicorn segurai_web:app --host 0.0.0.0 --port "${SEGURAI_WEB_PORT}") >>/data/segurai/segurai-web.log 2>&1 &
  fi
}

if [[ "$SEGURAI_ENABLED" == "true" || "$SEGURAI_WEB_ENABLED" == "true" || "$INGRESS_TARGET" == "segurai" ]]; then
  start_segurai
fi

if [[ "$SSH_ENABLED" == "true" ]]; then
  mkdir -p "$CODEX_HOME/.ssh"
  jq -r '.ssh_public_keys[]? // empty' "$CONFIG_PATH" > "$CODEX_HOME/.ssh/authorized_keys"
  chmod 700 "$CODEX_HOME/.ssh"
  chmod 600 "$CODEX_HOME/.ssh/authorized_keys"
  /usr/sbin/sshd -D -p 2222 &
fi

if [[ "$WEB_TERMINAL_ENABLED" == "true" ]]; then
  mkdir -p /share/codex-agent
  {
    echo "[$(date -Is)] ttyd starting on ${CODEX_TERMINAL_PORT}"
    ttyd \
      --port "${CODEX_TERMINAL_PORT}" \
      --interface 0.0.0.0 \
      --writable \
      --terminal-type xterm-256color \
      --client-option titleFixed="Codex Agent" \
      --client-option cursorBlink=true \
      --client-option cursorStyle=bar \
      --client-option theme='{"background":"#0b1020","foreground":"#e5e7eb","cursor":"#f97316","selection":"#334155"}' \
      --client-option disableLeaveAlert=true \
      /bin/bash /usr/local/bin/web-terminal.sh
  } >>/share/codex-agent/web-terminal.log 2>&1 &
fi

cat >/share/codex-agent/runtime.txt <<EOF
Codex Agent runtime

Workspace: ${WORKSPACE}
Codex home: ${CODEX_HOME}
PlatformIO core: ${PLATFORMIO_CORE_DIR}
Home Assistant API: ${HA_URL}
Supervisor API: ${SUPERVISOR_URL}
Home Assistant token configured: $(if [[ -n "${HA_TOKEN:-}" ]]; then echo "yes"; else echo "no"; fi)
MCP remote configured: $(if [[ -n "${MCP_SERVER_URL:-}" ]]; then echo "yes"; else echo "no"; fi)
MCP servers: $(codex mcp list 2>/dev/null | tr '\n' '; ' || true)
SegurAI enabled: ${SEGURAI_ENABLED}
SegurAI app: /data/segurai/app
SegurAI logs: /data/segurai/segurai-service.log
SegurAI WhatsApp: ${SEGURAI_WHATSAPP_ENABLED}
WhatsApp status/QR: /data/segurai/whatsapp
Ingress target: ${INGRESS_TARGET}
Codex terminal port: ${CODEX_TERMINAL_PORT}
SegurAI web port: ${SEGURAI_WEB_PORT}
ESPHome: $(esphome-version-check 2>/dev/null || true)

Useful commands:
  Open the Codex Agent sidebar panel for a web terminal.
  codex-login-chatgpt
  codex --model "${CODEX_MODEL}" "${WORKSPACE}"
  ha-states
  ha-services
  ha-api GET /config
  ha-call-service light turn_on '{"entity_id":"light.example"}'
  supervisor-api GET /addons
  host-shell
EOF

echo "[codex-agent] ready"
echo "[codex-agent] workspace: ${WORKSPACE}"
echo "[codex-agent] require_confirmation: ${REQUIRE_CONFIRMATION}"
echo "[codex-agent] ingress target: ${INGRESS_TARGET}"
echo "[codex-agent] web terminal: ${WEB_TERMINAL_ENABLED} on port ${CODEX_TERMINAL_PORT}"
echo "[codex-agent] segurai: ${SEGURAI_ENABLED} web port ${SEGURAI_WEB_PORT}"
esphome-version-check || true
echo "[codex-agent] start a shell with: docker exec -it <container> bash"

tail -f /dev/null
